@model List<MonthlyExpenseTracker.ViewModels.Transaction.TransactionListItemViewModel>

@{
    ViewData["Tittile"] = "Danh sách giao dịch";
}
@if (TempData["ErrorMessage"] is string message)
{
    <div class="alert alert-warning" role="alert">
        @message
    </div>
}

<h1>Danh sách giao dịch</h1>
<a asp-action="Create" class="btn btn-sm btn-primary">Create</a>
@if(Model.Count == 0)
{
    <p> Chưa có giao dịch nào.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th scope="col">Ngày giao dịch</th>
                    <th scope="col">Danh mục</th>
                    <th scope="col" class="text-end">Số tiền</th>
                    <th scope="col">Ghi chú</th>
                    <th scope="col">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in Model)
                {
                    <tr>
                        <td>
                            @transaction.TransactionDate.ToString("dd/MM/yyyy")
                        </td>
                        <td>@transaction.CategoryName</td>
                        <td class="text-end">
                            @transaction.Amount.ToString("N2")
                        </td>
                        <td>@transaction.Note</td>
                        <td>
                            <a asp-action="Edit" asp-route-transactionId="@transaction.Id" class="btn btn-sm btn-warning"> Sửa
                            </a>

                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa giao dịch này không? Bạn vẫn có thể khôi phục giao dịch này.');">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="transactionId" value="@transaction.Id" />
                                <button type="submit" class="btn btn-sm btn-danger" >Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


